# Copy to `.env`. Nothing here is a secret except ENVIO_API_TOKEN.

# REQUIRED. HyperSync refuses every query without it, and the indexer stops on the first
# fetch rather than degrading to RPC -- `rpc.for: fallback` in config.yaml covers a
# HyperSync that answers badly, not one that never authenticates.
#
# Free, no card: https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=

# Postgres port for the local Docker container the CLI starts.
#
# Moved off Envio's default of 5433 because this machine already runs other Postgres
# instances on 5432 and 5433. Change it to whatever is free where you run this.
#
# Do NOT set ENVIO_PG_HOST. Setting it -- even to `localhost` -- makes the CLI conclude you
# manage Postgres yourself, so it refuses to start its own container and fails with
# "Postgres is not reachable" instead of providing what it needs.
ENVIO_PG_PORT=5440
ENVIO_PG_USER=postgres
ENVIO_POSTGRES_PASSWORD=testing
ENVIO_PG_DATABASE=envio-dev

# Log to a file rather than drawing a TUI, so a run can be read back after it ends.
ENVIO_TUI=false
LOG_STRATEGY=file-only
LOG_FILE=./logs/indexer.log
