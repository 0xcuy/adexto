# Graph Node stack (docker-compose.yml in this directory).
#
# Copy to `.env` before `docker compose up -d`. Only one value matters, and only
# because Postgres refuses to start without one.

# Postgres password for the indexer store. Never leaves the compose project:
# Postgres publishes no host port and lives on the private `graph-internal`
# network. Change it anyway if you would rather not have a known string in a
# running container's environment.
GRAPH_POSTGRES_PASSWORD=graph-local-only
