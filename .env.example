# ADEXTO Protocol — environment template
# Copy to `.env.local` and fill in. Never commit .env.local.

# ── 0G Compute router ───────────────────────────────────────────────────────
OG_ROUTER_URL=https://router-api.0g.ai/v1
OG_ROUTER_API_KEY=your_0g_router_api_key_here
OG_MODEL=glm-5.3

# ── 0G network ──────────────────────────────────────────────────────────────
OG_CHAIN_ID=16661
OG_RPC_URL=https://evmrpc.0g.ai
OG_TESTNET_RPC_URL=https://evmrpc-testnet.0g.ai
OG_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai

# ── Deployer key (server-side only; used for 0G DA metadata anchoring) ──────
# When unset, /api/deploy still works: the DA anchor becomes a deterministic
# simulated root instead of an on-chain storage upload, and no gas is spent.
OG_PRIVATE_KEY=your_evm_private_key_without_quotes
PRIVATE_KEY=your_evm_private_key_without_quotes
SIGNER_ADDRESS=0x8a3c7524Aaed081825aC88eC7f4cCECFc583ee7D

# ── Durable storage ─────────────────────────────────────────────────────────
# Directory for the project registry and trade telemetry. Must be writable by
# the runtime user (uid 1001 in the container). Falls back to <cwd>/.data and
# then the system temp dir, both of which are ephemeral in Docker.
ADEXTO_DATA_DIR=/app/data

# ── Telemetry ingestion ─────────────────────────────────────────────────────
# Required for POST /api/agent/telemetry. Minimum 16 characters. Without it the
# endpoint rejects every write (fail closed) rather than accepting anonymous
# trade injection.
ADEXTO_TELEMETRY_SECRET=generate_a_long_random_secret_here

# ── Reserved-ticker launches ────────────────────────────────────────────────
# Address(es) allowed to launch a RESERVED ticker (ADEXTO, ADX, AEGIS, QNOVA,
# CSENT, MQUANT, plus native and blue-chip symbols — see RESERVED_SYMBOLS in
# src/lib/registry.ts).
#
# Reserving those tickers keeps squatters out, but it also locks the protocol out
# of its own token: without this set, the studio refuses "ADEXTO" from EVERY
# address, including ours. Set it to the deployer wallet before the mainnet launch
# of ADEXTO, and leave it empty otherwise — empty means nobody can claim a
# reserved ticker, which is the safe default.
#
# Comma-separated to allow a hardware wallet plus a hot deployer.
ADEXTO_OFFICIAL_DEPLOYER=

# ── Curve factories (AdextoCurveFactory) ────────────────────────────────────
# Set after broadcasting: node scripts/deploy-sovereign-curve.mjs --chain base --broadcast
#
# Generasi tanpa setoran: 100% supply masuk kurva, tidak ada seed native. Dipilih
# lebih dulu daripada FACTORY_V2 di bawah bila keduanya terisi.
#
# CATATAN: nilai NEXT_PUBLIC_* ter-inline saat `next build`, dan build terjadi DI
# DALAM image Docker. Jadi variabel ini WAJIB juga diteruskan sebagai build arg di
# docker-compose.yml -- itu pernah tidak dilakukan, dan akibatnya bundle klien
# meng-inline `null` untuk setiap curve factory sementara host-nya sudah benar.
NEXT_PUBLIC_CURVE_FACTORY_0G=
NEXT_PUBLIC_CURVE_FACTORY_ARBITRUM=
NEXT_PUBLIC_CURVE_FACTORY_BASE=
NEXT_PUBLIC_CURVE_FACTORY_MONAD=

# ── Sovereign DEX factories (AdextoTrinityFactoryV2) ────────────────────────
# Set after broadcasting: node scripts/deploy-sovereign-dex.mjs --chain 0g --broadcast
# A chain without a value here is shown as "DEX not live" and launching/trading
# on it stays disabled instead of sending transactions that revert.
NEXT_PUBLIC_FACTORY_V2_0G=
NEXT_PUBLIC_FACTORY_V2_ARBITRUM=
NEXT_PUBLIC_FACTORY_V2_BASE=
NEXT_PUBLIC_FACTORY_V2_MONAD=

# ── World ID: DICABUT, jangan diset ─────────────────────────────────────────
#
# Sembilan variabel WORLD_ID_* dulu ada di sini. Semuanya dihapus bersama seluruh
# integrasinya: modul, dua rute API, widget IDKit, dan paket @worldcoin/idkit.
#
# Alasannya praktis, bukan teknis. Action-nya menuntut verifikasi Orb untuk lewat,
# jadi gerbang itu mengunci hampir semua calon pengguna — termasuk pemilik proyek —
# di luar konsol peluncurannya sendiri. Gerbang yang tidak bisa dilewati siapa pun
# bukan keamanan, itu halaman mati.
#
# Kalau ada yang berpikir memasangnya kembali, dua fakta ini lebih dulu: `deployTrinity`
# di factory tidak punya access control sama sekali, jadi gerbang apa pun di aplikasi
# hanya menjaga PENDAFTARAN di registry situs, bukan peluncuran on-chain; dan
# audit_claims.mjs sekarang MELARANG frasa "World ID", "proof of personhood",
# "verified human", dan "distinct person" di seluruh rute, jadi menyalakannya kembali
# berarti mengubah penjaganya lebih dulu — dengan sadar, bukan diam-diam.
#
# Yang menggantikannya sebagai gerbang: attestation EIP-191 yang diverifikasi server
# (buktinya kendali alamat, bukan keunikan orang), ditambah batas ekonomi — satu ticker
# satu pemilik per chain, dan pendaftaran hanya terjadi setelah transaksi mined.

# ── The Graph ───────────────────────────────────────────────────────────────
# Deploy key dari https://thegraph.com/studio — untuk `graph auth`, bukan dibaca app.
GRAPH_DEPLOY_KEY=your_graph_studio_deploy_key_here

# Endpoint query subgraph, SATU PER CHAIN.
#
# Subgraph selalu satu jaringan — graph-node menolak manifest yang `templates`-nya
# beda `network` dengan `dataSources`. Jadi empat chain berarti empat deployment di
# empat URL, dan tiap URL bisa mati, tertinggal, atau belum ada secara terpisah.
#
# TANPA prefiks NEXT_PUBLIC_ dan itu disengaja: URL gateway memuat API key, dan
# meng-inline-nya ke bundle klien sama dengan mempublikasikannya. `/api/graphql`
# membaca subgraph di sisi server lalu mengembalikan data gabungan.
#
# Subgraph adalah jalur baca KEDUA. Registry tetap pertama dan sendirian menentukan
# pasar mana yang ada; subgraph cuma menempelkan keadaan kurva terkini. Semua
# variabel di bawah boleh kosong — app tetap jalan, `live` jadi null.
#
# Bentuk nilainya:
#   Studio / decentralized network  (Base, Arbitrum — The Graph melayani keduanya)
#     https://gateway.thegraph.com/api/<API_KEY>/subgraphs/id/<SUBGRAPH_ID>
#   Graph Node sendiri  (0G, Monad — The Graph TIDAK melayani keduanya, mainnet pun)
#     http://graph-node:8000/subgraphs/name/adexto/0g-testnet
#
# `graph-node` resolve di jaringan docker `adexto-net` yang dibagi bersama, jadi
# indexer-nya tidak perlu membuka port host sama sekali.
#
# URL yang masih mengandung placeholder (`/api/deploy-key/`, `/api/{api-key}/`)
# SENGAJA DITOLAK, bukan diteruskan. Revisi sebelumnya mengirim URL semacam itu dan
# tiap permintaan dijawab `auth error: malformed API key` — terlihat seperti indexer
# mati, padahal salah konfigurasi.
SUBGRAPH_URL_0G=
SUBGRAPH_URL_ARBITRUM=
SUBGRAPH_URL_BASE=
SUBGRAPH_URL_MONAD=
SUBGRAPH_URL_DEVCHAIN=

# Anggaran satu permintaan per chain (ms). Sengaja pendek: registry sudah
# menghasilkan jawaban lengkap, jadi indexer lambat hanya boleh menambah latensi.
SUBGRAPH_TIMEOUT_MS=2500

# Jendela cache statistik kurva gabungan (ms).
SUBGRAPH_CACHE_MS=10000

# ── App URLs ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://adexto.xyz
NEXT_PUBLIC_EDGE_GATEWAY=https://edge.adexto.xyz
