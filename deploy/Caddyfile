router.zexa.my.id {
    handle /api/webhook* {
        reverse_proxy 127.0.0.1:8788
    }
    handle /api/mailbox* {
        reverse_proxy 127.0.0.1:8788
    }
    handle {
        reverse_proxy 127.0.0.1:20128
    }
}
0g.zexa.my.id {
    reverse_proxy 127.0.0.1:20128
}
